{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug LauncherApp (x64-Debug)",
            "program": "${workspaceFolder}/ComputerGraphicsStudies.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "symbolSearchPath": "{env:_NT_SYMBOL_PATH};{cwd}/external/slang/bin;",
            "args": ["-v"]
        },
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug LauncherApp (x64-Release)",
            "program": "${workspaceFolder}/ComputerGraphicsStudies.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "symbolSearchPath": "{env:_NT_SYMBOL_PATH};{cwd}/external/slang/bin;"
        },
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "Debug ComputerGraphicsStudies (UNIX-rasterization)",
            "program": "${workspaceFolder}/ComputerGraphicsStudies",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "args": [
                "-r", "rasterization"
            ]
        },
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "Debug ComputerGraphicsStudies (UNIX-raytracing)",
            "program": "${workspaceFolder}/ComputerGraphicsStudies",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "args": [
                "-r",
                "raytracing"
            ]
        },
    ]
}