{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug RendererApp (x64-Debug)",
            "program": "${workspaceFolder}/out/build/x64-debug/RendererApp.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "CMake Build (x64-Debug)"
        },
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug RendererApp (x64-Release)",
            "program": "${workspaceFolder}/out/build/x64-release/RendererApp.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "CMake Build (x64-Release)"
        },
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "Debug RendererApp (clang-Debug)",
            "program": "${workspaceFolder}/out/build/clang-debug/RendererApp",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "CMake Build (clang-Debug)"
        },
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "Debug RendererApp (clang-Release)",
            "program": "${workspaceFolder}/out/build/clang-release/RendererApp",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "preLaunchTask": "CMake Build (clang-Release)"
        }
    ]
}